# Pagedrill by Ouroboros. Copy to .env for local development.
# Do not put amounts in this file. Stripe Checkout shows the price.

APP_BASE_URL=http://localhost:3000
PORT=3000
PAGEDRILL_HTTP_ONLY=1
PAGEDRILL_STORE=local
PAGEDRILL_DATA_DIR=.data
PAGEDRILL_SIGNING_SECRET=replace-me
PAGEDRILL_PURGE_SECRET=replace-me
PAGEDRILL_DEV_AUTH=1
PAGEDRILL_DEV_TOKEN=dev-pagedrill

# Leave blank until the Stripe product and prices already exist.
# Pagedrill does not create Stripe products or prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_ID=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides. Defaults: 60 formatted documents, 120 previews, 25 MB.
# PAGEDRILL_CAP_FORMATS=60
# PAGEDRILL_CAP_PREVIEWS=120
# PAGEDRILL_CAP_FILES=120
# PAGEDRILL_CAP_MAX_BYTES=26214400
